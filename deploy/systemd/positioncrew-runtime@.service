[Unit]
Description=PositionCrew Termix A2A runtime (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=crosswind
WorkingDirectory=/home/crosswind/apps/positioncrew
EnvironmentFile=/home/crosswind/.config/positioncrew/runtimes/%i.env
Environment=POSITIONCREW_ORIGIN=https://positioncrew.dolepee.com
Environment=TERMIX_A2A_STATE_PATH=/home/crosswind/.local/state/positioncrew/%i.json
ExecStart=/home/crosswind/apps/positioncrew/node_modules/.bin/tsx src/cli/run-termix-runtime.ts
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/crosswind/.local/state/positioncrew
StandardOutput=append:/home/crosswind/.local/log/positioncrew/%i.log
StandardError=append:/home/crosswind/.local/log/positioncrew/%i.log

[Install]
WantedBy=multi-user.target
