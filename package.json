{
  "name": "positioncrew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Job-first BSC capital operations with reproducible agent advantage evidence",
  "scripts": {
    "build": "npm run build:core && npm run build:web && npm run build:sites",
    "build:core": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build:sites": "node scripts/build-sites.mjs",
    "dev": "npm run build && wrangler dev --config dist/server/wrangler.json --port 4175",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "preview": "wrangler dev --config dist/server/wrangler.json --port 4175",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark:verify-lock": "tsx src/cli/verify-benchmark-lock.ts",
    "benchmark:verify-locks": "tsx src/cli/verify-benchmark-lock.ts",
    "verify:gate2a": "tsx src/cli/run-lending-rescue.ts",
    "verify:all": "tsx src/cli/verify-all-providers.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.122.0"
  }
}
